# Better Auth
# Generate with: bunx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Full absolute URL of the deployed app, e.g. https://example.com
BETTER_AUTH_URL=

# Optional: database URL for better-auth (Kysely/Drizzle adapter)
# DATABASE_URL=postgres://user:pass@localhost:5432/db

# Optional: OpenAPI document URL used by openapi-fetch (generate client from it)
# OPENAPI_URL=/api/openapi.json